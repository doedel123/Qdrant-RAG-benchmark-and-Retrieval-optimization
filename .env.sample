# Qdrant Cloud (Pflicht)
QDRANT_ENDPOINT=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Lokale Query Expansion ueber Ollama.
QUERY_EXPANSION_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EXPANSION_MODEL=gemma4:latest

# Lokales Reranking.
RERANK_PROVIDER=local
LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Remote-Fallbacks nur fuer Benchmarks/Altbetrieb explizit setzen.
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Ragie API (nur fuer Benchmark-Vergleich)
RAGIE_API_KEY=

# OpenAI API + Vector Store ID (nur fuer Benchmark-Vergleich)
OPENAI_API_KEY=
OPENAI_VECTOR_STORE_ID=
