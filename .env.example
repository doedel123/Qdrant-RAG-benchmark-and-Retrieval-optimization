# Eigener API-Key zum Absichern deiner /search und /openai/tool_schema Endpoints.
# Wird von Clients als HTTP-Header `X-API-Key` mitgesendet.
API_KEY=dein-selbst-gewaehlter-secret-token

# Qdrant Cloud — Vektor-Datenbank
QDRANT_ENDPOINT=https://xxxxxxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=...

# Lokale Query Expansion ueber Ollama.
# Modell-Tag ggf. an deinen lokalen Ollama-Namen anpassen.
QUERY_EXPANSION_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EXPANSION_MODEL=gemma4:latest

# Lokales Reranking ueber sentence-transformers CrossEncoder.
RERANK_PROVIDER=local
LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Optionale Remote-Fallbacks nur explizit setzen, wenn gewollt:
# QUERY_EXPANSION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# RERANK_PROVIDER=cohere
COHERE_API_KEY=...

# Railway setzt PORT automatisch; lokal default 8080.
# PORT=8080
